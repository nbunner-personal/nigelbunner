---
permalink: /sw.js
eleventyExcludeFromCollections: true
---
{%- comment -%}
  Precache: the 5 latest posts, the main section pages, every page in
  src/pages (except ones excluded from the sitemap), the CSS and hero images.
{%- endcomment -%}
{%- assign latestPosts = collections.posts | reverse -%}
{%- capture urls -%}
{%- for post in latestPosts limit: 5 -%}{{ post.url }},{%- endfor -%}
/,/blog/,/glossary/,
{%- for item in collections.sitemap -%}
{%- if item.inputPath contains "/src/pages/" -%}{{ item.url }},{%- endif -%}
{%- endfor -%}
/css/nb-styles.css,/img/nigel-walking--sm-mobile.jpg,/img/nigel-walking--tablet.jpg,/img/nigel-walking--desktop.jpg
{%- endcapture %}
// The version is a hash of the precached URLs and the CSS/image sources, so a
// new cache (and a re-download) only happens when one of them changes. The old
// cache is deleted in "activate" below.
const staticCacheName = "nigelbunner-cache-{{ urls | swVersion }}";

const filesToCache = {{ urls | split: "," | json }};

// Shown when offline and the requested page was never cached.
const offlineFallback = "/";

self.addEventListener("install", (e) => {
  self.skipWaiting();
  e.waitUntil(caches.open(staticCacheName).then((cache) => cache.addAll(filesToCache)));
});

self.addEventListener("activate", (e) => {
  e.waitUntil(
    caches.keys().then((cacheNames) =>
      Promise.all(
        cacheNames
          .filter((name) => name.startsWith("nigelbunner-cache-") && name !== staticCacheName)
          .map((name) => caches.delete(name))
      )
    )
  );
});

self.addEventListener("fetch", (e) => {
  if (e.request.method !== "GET") return;

  // Pages: try the network first so new posts show up, fall back to the cache offline.
  if (e.request.mode === "navigate") {
    e.respondWith(
      fetch(e.request)
        .then((response) => {
          // Only cache successful pages, so a 404 or 500 never replaces a good copy.
          if (response.ok) {
            const copy = response.clone();
            caches.open(staticCacheName).then((cache) => cache.put(e.request, copy));
          }
          return response;
        })
        .catch(() =>
          caches
            .match(e.request)
            .then((cached) => cached || caches.match(offlineFallback))
            .then((cached) => cached || Response.error())
        )
    );
    return;
  }

  // Everything else (CSS, images): cache first.
  e.respondWith(caches.match(e.request).then((response) => response || fetch(e.request)));
});
